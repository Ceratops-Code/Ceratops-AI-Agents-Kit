{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ceratops-Code/Ceratops-AI-Agents-Kit/schemas/sdlc.v4.schema.json",
  "title": "Ceratops repository SDLC v4 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "repository"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "kind": {
      "const": "ceratops-sdlc"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "deliverables": {
      "$ref": "#/$defs/deliverables"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "parameter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "capability": {
      "description": "Annotation-only executable metadata. Callers may report it but must not infer setup commands from it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "version-from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "key"
          ],
          "properties": {
            "file": {
              "$ref": "#/$defs/relativePath"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "includes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "runStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "handoff": {
      "description": "A lifecycle request returned to a skill caller. CI records it as deferred and never dispatches it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "action",
        "inputs"
      ],
      "properties": {
        "lifecycle": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "type": "object"
        }
      }
    },
    "handoffStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff"
      ],
      "properties": {
        "handoff": {
          "$ref": "#/$defs/handoff"
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/runStep"
        },
        {
          "$ref": "#/$defs/handoffStep"
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires"
      ],
      "properties": {
        "requires": {
          "$ref": "#/$defs/requirements"
        },
        "validation-capabilities": {
          "description": "Validation behavior supplied by this action and consumed by repository coverage requirements.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "result-schema": {
          "description": "Required structured stdout from the final run step. The repository operation runner validates the complete object and requires a passed terminal status.",
          "enum": [
            "ceratops-repository-stage-result.v1",
            "ceratops-build-result.v1",
            "ceratops-deployment-result.v1"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "no-op": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "oneOf": [
        {
          "required": [
            "steps"
          ]
        },
        {
          "required": [
            "no-op"
          ]
        }
      ]
    },
    "testSelectionAction": {
      "allOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "required": [
            "parameters",
            "steps"
          ],
          "properties": {
            "parameters": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "base",
                  "head"
                ]
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/runStep"
              }
            }
          }
        }
      ]
    },
    "repositoryActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validate",
        "test"
      ],
      "properties": {
        "bootstrap": {
          "$ref": "#/$defs/action"
        },
        "test-selection": {
          "$ref": "#/$defs/testSelectionAction"
        },
        "validate": {
          "$ref": "#/$defs/action"
        },
        "test": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "packageActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build"
      ],
      "properties": {
        "validate": {
          "$ref": "#/$defs/action"
        },
        "test": {
          "$ref": "#/$defs/action"
        },
        "build": {
          "$ref": "#/$defs/action"
        },
        "publish": {
          "$ref": "#/$defs/action"
        },
        "verify-publish": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "installedActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validate",
        "install"
      ],
      "properties": {
        "validate": {
          "$ref": "#/$defs/action"
        },
        "test": {
          "$ref": "#/$defs/action"
        },
        "install": {
          "$ref": "#/$defs/action"
        },
        "publish": {
          "$ref": "#/$defs/action"
        },
        "verify-publish": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "skillActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validate",
        "install"
      ],
      "properties": {
        "validate": {
          "$ref": "#/$defs/action"
        },
        "test": {
          "$ref": "#/$defs/action"
        },
        "install": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "artifact": {
      "description": "A package build output. Publication identity remains in the repository artifact contract until a later schema unifies those concerns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "output-directory",
        "filename-pattern"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/identifier"
        },
        "distribution": {
          "$ref": "#/$defs/identifier"
        },
        "output-directory": {
          "$ref": "#/$defs/relativePath"
        },
        "filename-pattern": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "python-wheel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "distribution"
            ]
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "prerequisites",
        "artifact",
        "actions"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "project": {
          "$ref": "#/$defs/relativePath"
        },
        "prerequisites": {
          "$ref": "#/$defs/packagePrerequisites"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "actions": {
          "$ref": "#/$defs/packageActions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact": {
                "properties": {
                  "type": {
                    "const": "python-wheel"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          },
          "then": {
            "required": [
              "project"
            ]
          }
        }
      ]
    },
    "packagePrerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "manifest",
        "prerequisites",
        "actions"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "manifest": {
          "$ref": "#/$defs/relativePath"
        },
        "prerequisites": {
          "$ref": "#/$defs/packagePrerequisites",
          "maxItems": 1
        },
        "actions": {
          "$ref": "#/$defs/installedActions"
        }
      }
    },
    "app": {
      "description": "An application installed on a target device or operating system.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "manifest",
        "prerequisites",
        "actions"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "manifest": {
          "$ref": "#/$defs/relativePath"
        },
        "prerequisites": {
          "$ref": "#/$defs/packagePrerequisites"
        },
        "actions": {
          "$ref": "#/$defs/installedActions"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "prerequisites",
        "actions"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "prerequisites": {
          "$ref": "#/$defs/packagePrerequisites"
        },
        "actions": {
          "$ref": "#/$defs/skillActions"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "prerequisites",
        "actions"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "prerequisites": {
          "$ref": "#/$defs/packagePrerequisites"
        },
        "actions": {
          "$ref": "#/$defs/skillActions"
        }
      }
    },
    "namedPackages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/package"
      }
    },
    "namedMcpServers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "namedApps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/app"
      }
    },
    "namedSkills": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/skill"
      }
    },
    "namedHooks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hook"
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "actions"
      ],
      "properties": {
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/capability"
          }
        },
        "actions": {
          "$ref": "#/$defs/repositoryActions"
        }
      }
    },
    "deliverables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "packages": {
          "$ref": "#/$defs/namedPackages"
        },
        "mcp-servers": {
          "$ref": "#/$defs/namedMcpServers"
        },
        "apps": {
          "$ref": "#/$defs/namedApps"
        },
        "skills": {
          "$ref": "#/$defs/namedSkills"
        },
        "hooks": {
          "$ref": "#/$defs/namedHooks"
        }
      }
    }
  }
}
