{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceratops.dev/schemas/github/github-lifecycle-deterministic-contract.schema.json",
  "title": "GitHub lifecycle deterministic state contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_format_version",
    "kind",
    "name",
    "source_docs_ref",
    "parameters",
    "checks",
    "fetch_bundles",
    "approved_drift",
    "non_deterministic_review_file"
  ],
  "properties": {
    "contract_format_version": { "const": 2 },
    "kind": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "captured_on": {
      "description": "Annotation-only provenance date; it does not change validation behavior.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "captured_from": {
      "description": "Annotation-only provenance label; it does not change validation behavior.",
      "type": "string",
      "minLength": 1
    },
    "source_docs_ref": { "type": "string", "minLength": 1 },
    "source_doc_scopes": {
      "description": "Annotation-only source-registry scopes used during human contract review.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["org", "repo", "artifact"] }
    },
    "source_files": {
      "description": "Annotation-only provenance references; executable evidence comes from collectors.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceFile" }
    },
    "required_scopes": {
      "description": "Annotation-only caller prerequisite documentation; the validator does not inspect token scopes.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "optional_scopes_for_full_screen_parity": {
      "description": "Annotation-only caller prerequisite documentation for optional coverage.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/optionalScope" }
    },
    "workflow_job_permissions_required_by_checks": {
      "description": "Annotation-only workflow-permission guidance; workflow scans and assertions enforce observable posture.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/workflowPermission" }
    },
    "non_deterministic_review_file": { "type": "string", "minLength": 1 },
    "parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "fetch_bundles": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/fetchBundle" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/artifactBundle" }
        }
      ]
    },
    "approved_drift": { "$ref": "#/$defs/approvedDrift" },
    "remediation_policy": {
      "description": "Annotation-only summary. It never grants mutation; CLI flags and the remediation-handler allowlist own executable mutation boundaries.",
      "$ref": "#/$defs/remediationPolicy"
    },
    "excluded_surfaces": {
      "description": "Annotation-only scope rationale used during human contract review.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/excludedSurface" }
    },
    "artifact_type_system": { "$ref": "#/$defs/artifactTypeSystem" }
  },
  "$defs": {
    "artifactIdentity": {
      "description": "External-artifact publication identity consumed by deterministic validation. ND.artifact.identity-contract-fit reviews whether the declared text matches the real artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "registry",
        "package_or_image_name",
        "version_source",
        "release_policy",
        "tag_style",
        "changelog_source",
        "post_publish_consumer_check"
      ],
      "properties": {
        "artifact_type": {
          "description": "Artifact type declared by the lifecycle artifact type system.",
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "description": "Registry host or lifecycle target such as github_release or pages.",
          "type": "string",
          "minLength": 1
        },
        "package_or_image_name": {
          "description": "External package, image, release asset, module, chart, or site name.",
          "type": "string",
          "minLength": 1
        },
        "version_source": {
          "description": "Manifest, Git tag, release tag, package metadata, or another explicitly approved version source.",
          "type": "string",
          "minLength": 1
        },
        "release_policy": {
          "description": "Publication policy such as manual, tag-driven, workflow-driven, no-artifact, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "tag_style": {
          "description": "Tag format such as semver, v-prefix-semver, calendar, SHA, digest, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "changelog_source": {
          "description": "CHANGELOG.md, GitHub release notes, package metadata, or another explicitly approved changelog source.",
          "type": "string",
          "minLength": 1
        },
        "post_publish_consumer_check": {
          "description": "Command or endpoint used to verify consumers can fetch and use the published artifact.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "enum": ["string", "boolean", "array"] },
        "required": { "type": "boolean" },
        "default": {},
        "default_from": { "type": "string", "minLength": 1 },
        "allowed_values": { "type": "array", "uniqueItems": true },
        "description": {
          "description": "Annotation-only caller guidance for this executable parameter.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceFile": {
      "description": "Annotation-only source provenance entry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lines"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "lines": { "type": "string", "minLength": 1 }
      }
    },
    "optionalScope": {
      "description": "Annotation-only optional authorization guidance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "enables", "reason"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "enables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "workflowPermission": {
      "description": "Annotation-only workflow-permission guidance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["permission", "enables", "reason"],
      "properties": {
        "permission": { "type": "string", "minLength": 1 },
        "enables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "excludedSurface": {
      "description": "Annotation-only excluded-scope rationale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "reason"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertions"],
      "dependentRequired": { "method": ["endpoint"] },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "Annotation-only check classification label.",
          "type": "string",
          "minLength": 1
        },
        "category": {
          "description": "Annotation-only report grouping label.",
          "type": "string",
          "minLength": 1
        },
        "applies_when": { "type": "string" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "collection": { "$ref": "#/$defs/collection" },
        "endpoint": { "type": "string", "pattern": "^/" },
        "desired": {},
        "remediation_action": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "HEAD"] },
        "allowed_uninitialized_error": { "$ref": "#/$defs/uninitializedError" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["empty", "not_empty", "truthy", "falsy", "any_true", "all_true"]
              }
            },
            "required": ["operator"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["expected"] },
                { "required": ["desired_path"] }
              ]
            }
          },
          "else": {
            "oneOf": [
              { "required": ["expected"] },
              { "required": ["desired_path"] }
            ]
          }
        }
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": [
            "equal",
            "equal_ci",
            "subset_equal",
            "contains_subset",
            "empty",
            "not_empty",
            "truthy",
            "falsy",
            "in",
            "not_in",
            "lte",
            "lt",
            "gte",
            "gt",
            "matches",
            "not_matches",
            "contains",
            "not_contains",
            "contains_all",
            "any_true",
            "all_true",
            "all_objects_have",
            "all_versions_gte",
            "max_items",
            "min_items",
            "glob_present",
            "glob_absent"
          ]
        },
        "desired_path": { "type": "string", "minLength": 1 },
        "expected": {},
        "level": {
          "enum": ["ERROR", "WARN", "NEEDS_AI_AGENT_REVIEW", "INFO", "PASS", "SKIP"]
        },
        "when": { "type": "string" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regex_patterns": { "type": "array", "items": { "type": "string" } },
        "ignore_paths": { "type": "array", "items": { "type": "string" } },
        "ignore_windows_path_prefixes": { "type": "array", "items": { "type": "string" } },
        "report_open_prs_older_than_days": { "type": "number" },
        "ignored_branch_names": { "type": "array", "items": { "type": "string" } },
        "retained_branch_name_patterns": { "type": "array", "items": { "type": "string" } },
        "draft_review_after_days": { "type": "number" },
        "prerelease_review_after_days": { "type": "number" },
        "required_asset_name_patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "uninitializedError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message_contains", "only_when_public_repos_count"],
      "properties": {
        "status": { "type": "integer" },
        "message_contains": { "type": "string" },
        "only_when_public_repos_count": { "type": "integer" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^/" },
        "method": { "enum": ["GET", "HEAD"] },
        "covers_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "paginate": { "type": "boolean" },
        "applies_when": { "type": "string" }
      }
    },
    "fetchBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "purpose": {
          "description": "Annotation-only explanation of the request bundle.",
          "type": "string",
          "minLength": 1
        },
        "requests": { "type": "array", "items": { "$ref": "#/$defs/request" } },
        "applies_when": { "type": "string" },
        "covers_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "description": "Annotation-only source inventory; requests and collectors own execution.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Annotation-only explanation of the request bundle.",
          "type": "string",
          "minLength": 1
        },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/request" }
        },
        "feeds_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvedDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowances", "exclusions"],
      "properties": {
        "allowances": {
          "type": "array",
          "items": { "$ref": "#/$defs/allowance" }
        },
        "exclusions": {
          "description": "Annotation-only reserved surface; executable exclusions are not supported.",
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "when": { "type": "string" },
        "allowed_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "check_id": { "type": "string" },
        "reason": {
          "description": "Annotation-only explanation; allowance matching uses id, check selectors, and when.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "remediationPolicy": {
      "description": "Annotation-only summary of separately enforced CLI and handler behavior.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_mode": { "const": "report_only" },
        "default": { "const": "report_only" },
        "apply_flag": { "enum": ["--apply", null] },
        "destructive_or_irreversible": { "const": "always_report_only" },
        "publish_or_registry_mutation": { "const": "never_apply_from_audit_only_flow" },
        "token_or_secret_changes": { "const": "explicit_user_approval_required" }
      }
    },
    "artifactTypeSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "classification_fields",
        "candidate_detectors",
        "external_publish_detectors",
        "behavior_explanations"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactCategory" }
        },
        "classification_fields": {
          "$ref": "#/$defs/artifactClassificationFields"
        },
        "candidate_detectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactDetector" }
        },
        "external_publish_detectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactDetector" }
        },
        "behavior_explanations": {
          "description": "Annotation-only explanations of collector behavior; executable predicates, assertions, and tests own enforcement.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/behaviorExplanation" }
        }
      }
    },
    "artifactClassificationFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_buildable_candidates",
        "confirmed_external_artifacts"
      ],
      "properties": {
        "local_buildable_candidates": { "const": "artifact_candidates" },
        "confirmed_external_artifacts": { "const": "artifact_surface" }
      }
    },
    "artifactCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_types"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "artifact_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactDetector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "confidence"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "confidence": {
          "description": "Annotation-only evidence-strength label; detector predicates determine classification.",
          "enum": ["high", "medium", "low"]
        },
        "when_any_path_matches": { "type": "array", "items": { "type": "string" } },
        "and_when_any_path_matches": { "type": "array", "items": { "type": "string" } },
        "and_when_matching_path_contains_any": { "type": "array", "items": { "type": "string" } },
        "and_when_matching_path_contains_all": { "type": "array", "items": { "type": "string" } },
        "and_when_matching_json_field_not_true": { "type": "string", "minLength": 1 },
        "when_workflow_contains_any": { "type": "array", "items": { "type": "string" } },
        "and_when_workflow_contains_any": { "type": "array", "items": { "type": "string" } },
        "and_when_workflow_contains_all": { "type": "array", "items": { "type": "string" } },
        "when_release_assets_count_gt": { "type": "number" },
        "when": { "type": "string" }
      }
    },
    "behaviorExplanation": {
      "description": "Annotation-only collector-behavior explanation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    }
  }
}
