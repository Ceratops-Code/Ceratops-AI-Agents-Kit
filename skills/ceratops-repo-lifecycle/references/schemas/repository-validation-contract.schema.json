{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceratops.dev/schemas/repository-validation-contract.schema.json",
  "title": "Repository validation generation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_format_version", "kind", "name", "source_docs_ref", "source_doc_scopes", "ruff_policy", "coverage_requirements", "checks"],
  "properties": {
    "contract_format_version": {"const": 1},
    "kind": {"const": "repository_validation_contract"},
    "name": {"const": "ceratops_repository_validation_contract"},
    "captured_on": {
      "description": "Annotation-only review provenance; it does not select or execute checks.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_docs_ref": {"const": "github-contract-source-docs.json"},
    "source_doc_scopes": {
      "description": "Annotation-only source-registry scopes for standards review and validator discovery; their references are validated by the contract loader.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ruff_policy": {
      "description": "Required Ruff settings consumed by python_tool_configuration during generation and compatibility checks. Ruff expands selectors and ignores using the selected tool runtime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target-version", "select", "ignore"],
      "properties": {
        "target-version": {"type": "string", "pattern": "^py3[0-9]{1,2}$"},
        "select": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[A-Z]+[0-9]*|ALL)$"}
        },
        "ignore": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[A-Z]+[0-9]*|ALL)$"}
        }
      }
    },
    "coverage_requirements": {
      "description": "Required validation coverage consumed by validate_ceratops_compatibility without generating duplicate repository commands.",
      "type": "array",
      "items": {"$ref": "#/$defs/coverageRequirement"}
    },
    "checks": {
      "description": "Executable check selection and command data consumed by apply_ceratops_compatibility.contract_checks and the generated repository validator.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "path": {
      "description": "Repository-relative path or Python glob; ** matches zero or more complete directory levels. The contract loader also rejects absolute paths, drives, and parent traversal.",
      "type": "string",
      "minLength": 1
    },
    "packageScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "package-script"},
        "manager": {"enum": ["npm", "pnpm"]},
        "value": {"$ref": "#/$defs/text"}
      }
    },
    "pathAny": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "path-any"},
        "value": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "fileContains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "value"],
      "properties": {
        "kind": {"const": "file-contains"},
        "path": {"$ref": "#/$defs/path"},
        "value": {"$ref": "#/$defs/text"}
      }
    },
    "condition": {
      "description": "Executable predicates consumed by apply_ceratops_compatibility._validation_condition_matches.",
      "oneOf": [
        {"$ref": "#/$defs/packageScript"},
        {"$ref": "#/$defs/pathAny"},
        {"$ref": "#/$defs/fileContains"}
      ]
    },
    "coverageRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "operation_category", "required_capabilities", "required_prerequisites", "require_repository_entrypoint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathAny"}},
        "operation_category": {"const": "validate"},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
        },
        "required_prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
        },
        "require_repository_entrypoint": {"const": true}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "command", "cwd"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
        "unless": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "command": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "cwd": {"$ref": "#/$defs/path"},
        "exclusive": {"type": "boolean"}
      }
    }
  }
}
