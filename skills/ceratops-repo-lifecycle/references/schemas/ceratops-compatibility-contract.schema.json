{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceratops.dev/schemas/ceratops-compatibility-contract.schema.json",
  "title": "Internal Ceratops compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_format_version",
    "kind",
    "description",
    "non_deterministic_review_file",
    "surfaces",
    "manifest_profiles",
    "generated_manifest_profile",
    "managed_skill_operations",
    "sdlc_version",
    "runtime",
    "skill_python_runtime",
    "python_test_detection",
    "dependency_updates",
    "ci_action",
    "ci_dependency_updates"
  ],
  "properties": {
    "contract_format_version": {
      "const": 1,
      "description": "Executable: loader dispatch format."
    },
    "kind": {
      "const": "ceratops_compatibility_contract",
      "description": "Executable: loader identity check."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Annotation-only: internal scope and ownership."
    },
    "non_deterministic_review_file": {
      "$ref": "#/$defs/filename",
      "description": "Executable: loader validates the companion and reverse reference."
    },
    "surfaces": {
      "description": "Executable: generator destinations/templates and checker applicability/required files.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator",
        "workflow",
        "issue_template",
        "pull_request_template",
        "sdlc",
        "skill_manifest",
        "skill_bootstrap",
        "validation_project",
        "python_test_runner",
        "actionlint_runner"
      ],
      "properties": {
        "validator": {
          "$ref": "#/$defs/surface"
        },
        "workflow": {
          "$ref": "#/$defs/surface"
        },
        "issue_template": {
          "$ref": "#/$defs/surface"
        },
        "pull_request_template": {
          "$ref": "#/$defs/surface"
        },
        "sdlc": {
          "$ref": "#/$defs/surface"
        },
        "skill_manifest": {
          "$ref": "#/$defs/surface"
        },
        "skill_bootstrap": {
          "$ref": "#/$defs/surface"
        },
        "validation_project": {
          "$ref": "#/$defs/surface"
        },
        "python_test_runner": {
          "$ref": "#/$defs/surface"
        },
        "actionlint_runner": {
          "$ref": "#/$defs/surface"
        }
      }
    },
    "manifest_profiles": {
      "$ref": "#/$defs/strings",
      "description": "Executable: checker and generator accept only these manifest profiles."
    },
    "generated_manifest_profile": {
      "type": "string",
      "minLength": 1,
      "description": "Executable: generator default; loader verifies it is accepted."
    },
    "managed_skill_operations": {
      "type": "object",
      "description": "Executable: generator supplies named v4 skill actions and removes only exact owned definitions when source skills disappear; loader validates materialized actions against the SDLC schema.",
      "additionalProperties": false,
      "required": [
        "validate",
        "install"
      ],
      "properties": {
        "validate": {
          "$ref": "#/$defs/managed_skill_action"
        },
        "install": {
          "$ref": "#/$defs/managed_skill_action"
        }
      }
    },
    "sdlc_version": {
      "const": 4,
      "description": "Executable: generated SDLC version and current-compatibility checker requirement."
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "lockfile",
        "environment",
        "ignored_paths"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/relative_path"
        },
        "lockfile": {
          "$ref": "#/$defs/relative_path"
        },
        "environment": {
          "$ref": "#/$defs/relative_path"
        },
        "ignored_paths": {
          "$ref": "#/$defs/strings"
        }
      },
      "description": "Executable: generator creates and syncs the isolated scripts project; checker verifies declarations, lock and interpreter."
    },
    "skill_python_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "lockfile"],
      "properties": {
        "project": {"$ref": "#/$defs/relative_path"},
        "lockfile": {"$ref": "#/$defs/relative_path"}
      },
      "description": "Executable: generator copies the source-only pair for Python skills; checker requires its locked declarations."
    },
    "python_test_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "configuration_files",
        "excluded_directories"
      ],
      "properties": {
        "patterns": {
          "$ref": "#/$defs/strings"
        },
        "configuration_files": {
          "$ref": "#/$defs/strings"
        },
        "excluded_directories": {
          "$ref": "#/$defs/strings"
        }
      },
      "description": "Executable: deterministic test candidate discovery used by generator and checker; custom configurations still require repository review."
    },
    "dependency_updates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package-ecosystem",
        "directory",
        "schedule"
      ],
      "properties": {
        "package-ecosystem": {
          "const": "uv"
        },
        "directory": {
          "type": "string",
          "pattern": "^/"
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval"
          ],
          "properties": {
            "interval": {
              "enum": [
                "daily",
                "weekly",
                "monthly"
              ]
            }
          }
        }
      },
      "description": "Executable: generator registers the validator project with Dependabot without altering other ecosystem entries."
    },
    "ci_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses",
        "ref",
        "inputs"
      ],
      "description": "Executable: generator resolves this published action and supplies its inputs; checker requires its commit pin and input bindings.",
      "properties": {
        "uses": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9_./-]+$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo-root",
            "evidence-file"
          ],
          "properties": {
            "repo-root": {
              "type": "string",
              "minLength": 1
            },
            "evidence-file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ci_dependency_updates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package-ecosystem",
        "directory",
        "schedule"
      ],
      "properties": {
        "package-ecosystem": {
          "const": "github-actions"
        },
        "directory": {
          "const": "/"
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interval"
          ],
          "properties": {
            "interval": {
              "enum": [
                "daily",
                "weekly",
                "monthly"
              ]
            }
          }
        }
      },
      "description": "Executable: generator and checker require GitHub Actions dependency maintenance, preserving target schedules."
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "filename": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "template",
        "required"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path",
          "description": "Executable: repository-relative destination and checker target."
        },
        "template": {
          "$ref": "#/$defs/filename",
          "description": "Executable: trusted filename inside the bundle templates directory."
        },
        "required": {
          "enum": [
            "always",
            "with_skills",
            "when_present",
            "with_python_tests"
          ],
          "description": "Executable: required-file condition within an applicable repository."
        }
      }
    },
    "managed_skill_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "steps"
      ],
      "properties": {
        "requires": {
          "const": {
            "capabilities": []
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "handoff"
            ],
            "properties": {
              "handoff": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lifecycle",
                  "action",
                  "inputs"
                ],
                "properties": {
                  "lifecycle": {
                    "const": "ceratops-skill-lifecycle"
                  },
                  "action": {
                    "enum": [
                      "source-validate",
                      "deploy"
                    ]
                  },
                  "inputs": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "skill"
                    ],
                    "properties": {
                      "skill": {
                        "const": "{skill}"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
