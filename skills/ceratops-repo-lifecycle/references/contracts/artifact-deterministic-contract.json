{
  "contract_format_version": 2,
  "kind": "artifact_registry_contract",
  "name": "ceratops_artifact_deterministic_contract",
  "captured_on": "2026-05-02",
  "source_files": [
    {
      "path": "$CERATOPS_AI_AGENTS_KIT_ROOT/skills/ceratops-repo-lifecycle/references/create-or-publish.md",
      "lines": "1-6"
    }
  ],
  "parameters": {
    "owner": {
      "type": "string",
      "required": true
    },
    "repo": {
      "type": "string",
      "required": true
    },
    "default_branch": {
      "type": "string",
      "required": false,
      "default_from": "repo.default_branch"
    },
    "local_repo_path": {
      "type": "string",
      "required": false
    },
    "artifact_contracts": {
      "type": "array",
      "required": false,
      "description": "Annotation-only external-artifact identity records supplied explicitly; SDLC build-artifact declarations do not define publication identity. Every non-no_artifact record declares publication intent even when no workflow is present; it is not evidence of a completed publication."
    },
    "publish_requested": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided signal that this run intends publication; the audit never publishes by itself."
    },
    "local_build_succeeded": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-recorded result of the repository's local build or package step."
    },
    "consumer_smoke_succeeded": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-recorded result of consuming the built or published artifact."
    },
    "publish_authorized": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided confirmation that publication is authorized."
    },
    "linked_artifacts_claimed": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided signal that linked artifact metadata is claimed."
    },
    "artifact_was_published": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-recorded publication outcome used to activate live verification."
    },
    "final_answer_makes_no_artifact_claim": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided signal that the final result explicitly claims no external artifact."
    },
    "docker_build_push_action_default_provenance_applies": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-confirmed signal that the selected Docker build-push action emits provenance by default."
    },
    "current_change_affects_artifact": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided signal that the current repository change affects an external artifact or its publication path."
    },
    "final_answer_makes_artifact_claim": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided signal that the reported result claims an external artifact exists or was published."
    },
    "merged_change_requires_release": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Caller-provided signal that the merged change requires a release publication decision."
    },
    "audit_only": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "True for report-only contract audits; this validator never treats the flag as publication authorization."
    }
  },
  "required_scopes": [
    "repo",
    "workflow"
  ],
  "optional_scopes_for_full_screen_parity": [
    {
      "scope": "read:packages",
      "enables": [
        "github_packages.live_package_metadata"
      ],
      "reason": "Needed for private or internal GitHub Packages metadata and package-version reads."
    },
    {
      "scope": "write:packages",
      "enables": [
        "github_packages.publish_guard"
      ],
      "reason": "Needed only for explicitly approved publishing workflows, never for audit-only checks."
    }
  ],
  "workflow_job_permissions_required_by_checks": [
    {
      "permission": "id-token: write",
      "enables": [
        "common.attestation_permissions",
        "common.short_lived_identity_policy",
        "pypi.trusted_publishing_and_attestations",
        "npm.trusted_publishing_and_provenance",
        "nuget.trusted_publishing",
        "rubygems.trusted_publishing"
      ],
      "reason": "Workflow job permission needed when the selected registry supports OIDC or trusted publishing."
    },
    {
      "permission": "attestations: write",
      "enables": [
        "common.attestation_permissions"
      ],
      "reason": "Workflow job permission needed only for GitHub artifact attestation generation."
    },
    {
      "permission": "artifact-metadata: write",
      "enables": [
        "common.linked_artifact_metadata"
      ],
      "reason": "Needed only when the workflow intentionally records linked artifact metadata."
    }
  ],
  "source_docs_ref": "github-contract-source-docs.json",
  "source_doc_scopes": [
    "artifact"
  ],
  "remediation_policy": {
    "default_mode": "report_only",
    "publish_or_registry_mutation": "never_apply_from_audit_only_flow",
    "token_or_secret_changes": "explicit_user_approval_required",
    "destructive_or_irreversible": "always_report_only"
  },
  "approved_drift": {
    "exclusions": [],
    "allowances": [
      {
        "id": "audit_only_may_skip_publish_steps",
        "when": "audit_only == true",
        "allowed_checks": [
          "common.publish_guard",
          "common.live_registry_verification"
        ]
      }
    ]
  },
