    "behavior_explanations": [
      {
        "id": "multi_artifact_repos_are_allowed",
        "rule": "A repo may publish several artifact types; every detected external artifact gets its own identity record and applicable checks."
      },
      {
        "id": "candidate_evidence_is_not_publication",
        "rule": "Manifest and build metadata populate artifact_candidates only; artifact_surface requires an actual publish or push workflow, a release asset, matching registry evidence, or an explicit artifact contract."
      },
      {
        "id": "explicit_contract_confirms_manual_publication",
        "rule": "A non-no_artifact explicit contract enters artifact_surface without requiring a workflow, so manual publication remains representable."
      },
      {
        "id": "github_packages_is_registry_not_artifact_shape",
        "rule": "GitHub Packages may host containers, npm, Maven, NuGet, or RubyGems packages; run both the underlying artifact-type checks and GitHub Packages visibility/access checks."
      },
      {
        "id": "no_artifact_is_a_state",
        "rule": "When candidates exist without external publication evidence, retain artifact_candidates, report artifact_surface as no_artifact, keep external counts at zero, and do not require artifact identity or registry contracts."
      }
    ]
  },
  "fetch_bundles": {
    "github_release_bundle": {
      "description": "GitHub release, tag, and release-asset metadata for release artifacts and version verification.",
      "endpoints": [
        {
          "method": "GET",
          "endpoint": "/repos/${owner}/${repo}/releases?per_page=100",
          "paginate": true
        },
        {
          "method": "GET",
          "endpoint": "/repos/${owner}/${repo}/tags?per_page=100",
          "paginate": true
        }
      ],
      "feeds_checks": [
        "common.version_source",
        "common.live_registry_verification",
        "github_release_assets.assets_and_tags"
      ]
    },
    "github_pages_bundle": {
      "description": "GitHub Pages publishing-source metadata, collected only when the repository has Pages enabled.",
      "endpoints": [
        {
          "method": "GET",
          "endpoint": "/repos/${owner}/${repo}/pages",
          "applies_when": "repo.has_pages == true"
        }
      ],
      "feeds_checks": [
        "docs_site.publish_and_live_check"
      ]
    }
  },
  "checks": [
    {
      "id": "common.artifact_scope_trigger",
      "category": "common",
      "kind": "classification",
      "applies_when": "detected_external_artifact_count > 0 || current_change_affects_artifact == true || final_answer_makes_artifact_claim == true",
      "assertions": [
        {
          "path": "/artifact/types",
          "operator": "not_empty"
        }
      ]
    },
    {
      "id": "common.real_deliverable_classification",
      "category": "common",
      "kind": "tree_workflow_release_registry_scan",
      "applies_when": "detected_external_artifact_count > 0 || current_change_affects_artifact == true || final_answer_makes_artifact_claim == true",
      "assertions": [
        {
          "path": "/artifact/types",
          "operator": "not_empty"
        }
      ]
    },
    {
      "id": "common.identity_contract",
      "category": "common",
      "kind": "contract_and_metadata",
      "applies_when": "detected_external_artifact_count > 0",
      "desired": {
        "required_per_artifact_fields": [
          "artifact_type",
          "registry",
          "package_or_image_name",
          "version_source",
          "release_policy",
          "tag_style",
          "changelog_source",
          "post_publish_consumer_check"
        ]
      },
      "assertions": [
        {
          "path": "/artifact/contracts",
          "operator": "all_objects_have",
          "desired_path": "/desired/required_per_artifact_fields"
        },
        {
          "path": "/artifact/identity/missing_types",
          "operator": "empty"
        }
      ]
    },
    {
      "id": "common.audit_only_no_publish",
      "category": "common",
      "kind": "mode_guard",
      "applies_when": "audit_only == true",
      "assertions": [
        {
          "path": "/artifact/publish_requested",
          "operator": "equal",
          "expected": false
        }
      ]
    },
    {
      "id": "common.local_build_package_consume",
      "category": "common",
      "kind": "local_command_evidence",
      "applies_when": "current_change_affects_artifact == true || final_answer_makes_artifact_claim == true || merged_change_requires_release == true",
      "assertions": [
        {
          "path": "/artifact/recorded_checks/local_build",
          "operator": "equal",
          "expected": true
        },
        {
          "path": "/artifact/recorded_checks/consumer_smoke",
          "operator": "equal",
          "expected": true
        }
      ]
    },
    {
      "id": "common.publish_guard",
      "category": "common",
      "kind": "policy_guard",
      "applies_when": "audit_only == false",
      "assertions": [
        {
          "path": "/artifact/recorded_checks/publish_authorized",
          "operator": "equal",
          "expected": true
        }
      ]
    },
    {
      "id": "common.version_source",
      "category": "common",
      "kind": "metadata_and_tag_scan",
      "applies_when": "detected_external_artifact_count > 0",
      "assertions": [
        {
          "path": "/artifact/contracts",
          "operator": "all_objects_have",
          "expected": [
            "version_source"
          ]
        }
      ]
    },
    {
      "id": "common.live_registry_verification",
      "category": "common",
      "kind": "registry_api_or_cli",
      "applies_when": "detected_external_artifact_count > 0 && (artifact_was_published == true || final_answer_makes_artifact_claim == true || audit_only == false)",
      "assertions": [
        {
          "path": "/artifact/live_metadata/all_resolved",
          "operator": "equal",
          "expected": true
        }
      ]
    },
    {
      "id": "common.short_lived_identity_policy",
