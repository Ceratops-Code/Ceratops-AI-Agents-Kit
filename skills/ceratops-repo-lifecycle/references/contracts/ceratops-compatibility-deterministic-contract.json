{
  "contract_format_version": 1,
  "kind": "ceratops_compatibility_contract",
  "description": "Internal Ceratops repository structure and compatibility-generation defaults. Structural success is separate from the companion behavioral review. This contract stays in the lifecycle skill; targets own their generated files and dependencies.",
  "non_deterministic_review_file": "ceratops-compatibility-nondeterministic-contract.json",
  "surfaces": {
    "validator": {
      "path": "scripts/validate-repository.py",
      "template": "validate-repository.py.tmpl",
      "required": "always"
    },
    "workflow": {
      "path": ".github/workflows/validate.yml",
      "template": "validate.yml.tmpl",
      "required": "always"
    },
    "issue_template": {
      "path": ".github/ISSUE_TEMPLATE/bug_report.yml",
      "template": "issue-template-bug-report.yml.tmpl",
      "required": "always"
    },
    "pull_request_template": {
      "path": ".github/pull_request_template.md",
      "template": "pull-request-template.md.tmpl",
      "required": "always"
    },
    "sdlc": {
      "path": "sdlc/sdlc.yml",
      "template": "sdlc.yml.tmpl",
      "required": "always"
    },
    "skill_manifest": {
      "path": "skills/skill-sections.json",
      "template": "skill-sections.json.tmpl",
      "required": "with_skills"
    },
    "skill_bootstrap": {
      "path": "scripts/deploy-skills.py",
      "template": "deploy-skills.py.tmpl",
      "required": "with_skills"
    },
    "validation_project": {
      "path": "scripts/pyproject.toml",
      "template": "validation-pyproject.toml.tmpl",
      "required": "always"
    },
    "python_test_runner": {
      "path": "scripts/run-tests.py",
      "template": "run-tests.py.tmpl",
      "required": "with_python_tests"
    },
    "actionlint_runner": {
      "path": "scripts/run-actionlint.py",
      "template": "run-actionlint.py.tmpl",
      "required": "always"
    }
  },
  "manifest_profiles": [
    "ceratops",
    "ceratops-compatible"
  ],
  "generated_manifest_profile": "ceratops-compatible",
  "managed_skill_operations": {
    "validate": {
      "requires": {
        "capabilities": []
      },
      "steps": [
        {
          "handoff": {
            "lifecycle": "ceratops-skill-lifecycle",
            "action": "source-validate",
            "inputs": {
              "skill": "{skill}"
            }
          }
        }
      ]
    },
    "install": {
      "requires": {
        "capabilities": []
      },
      "steps": [
        {
          "handoff": {
            "lifecycle": "ceratops-skill-lifecycle",
            "action": "deploy",
            "inputs": {
              "skill": "{skill}"
            }
          }
        }
      ]
    }
  },
  "sdlc_version": 4,
  "runtime": {
    "project": "scripts",
    "lockfile": "scripts/uv.lock",
    "environment": "scripts/.venv",
    "ignored_paths": [
      ".venv/",
      "**/__pycache__/"
    ]
  },
  "skill_python_runtime": {
    "project": "skills/sections/python/pyproject.toml",
    "lockfile": "skills/sections/python/uv.lock"
  },
  "python_test_detection": {
    "patterns": [
      "test_*.py",
      "*_test.py",
      "tests.py"
    ],
    "configuration_files": [
      "pytest.toml",
      ".pytest.toml",
      "pytest.ini",
      ".pytest.ini",
      "conftest.py"
    ],
    "excluded_directories": [
      ".git",
      ".venv",
      "venv",
      "node_modules",
      "__pycache__",
      ".build",
      "build",
      "dist"
    ]
  },
  "dependency_updates": {
    "package-ecosystem": "uv",
    "directory": "/scripts",
    "schedule": {
      "interval": "weekly"
    }
  },
  "ci_action": {
    "uses": "Ceratops-Code/Ceratops-AI-Agents-Kit/skills/ceratops-repo-lifecycle/scripts",
    "ref": "refs/heads/main",
    "inputs": {
      "repo-root": "${{ github.workspace }}",
      "evidence-file": "${{ runner.temp }}/repository-validation.log"
    }
  },
  "ci_dependency_updates": {
    "package-ecosystem": "github-actions",
    "directory": "/",
    "schedule": {
      "interval": "weekly"
    }
  }
}
