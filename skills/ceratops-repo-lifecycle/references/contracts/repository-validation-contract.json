{
  "contract_format_version": 1,
  "kind": "repository_validation_contract",
  "name": "ceratops_repository_validation_contract",
  "captured_on": "2026-10-11",
  "source_docs_ref": "github-contract-source-docs.json",
  "source_doc_scopes": [
    "repository_validation"
  ],
  "ruff_policy": {
    "target-version": "py314",
    "select": [
      "E", "F", "I", "B",
      "S105", "S106", "S107", "S501", "S602", "S604", "S605",
      "ASYNC210", "ASYNC212", "ASYNC220", "ASYNC221", "ASYNC222",
      "ASYNC230", "ASYNC240", "ASYNC250", "ASYNC251",
      "DTZ003", "DTZ004", "DTZ005", "DTZ006", "UP", "RUF100"
    ],
    "ignore": ["E501"]
  },
  "coverage_requirements": [
    {
      "id": "android-gradle",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "**/src/main/AndroidManifest.xml"
          ]
        }
      ],
      "operation_category": "validate",
      "required_capabilities": [
        "android-lint",
        "android-build"
      ],
      "required_prerequisites": [
        "jdk",
        "android-sdk"
      ],
      "require_repository_entrypoint": true
    },
    {
      "id": "go-module",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "**/go.mod"
          ]
        }
      ],
      "operation_category": "validate",
      "required_capabilities": [
        "go-vet"
      ],
      "required_prerequisites": [
        "go"
      ],
      "require_repository_entrypoint": true
    },
    {
      "id": "rust-cargo",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "**/Cargo.toml"
          ]
        }
      ],
      "operation_category": "validate",
      "required_capabilities": [
        "rustfmt-check",
        "rust-clippy"
      ],
      "required_prerequisites": [
        "rustfmt",
        "clippy"
      ],
      "require_repository_entrypoint": true
    },
    {
      "id": "dotnet",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "**/*.csproj",
            "**/*.fsproj",
            "**/*.vbproj"
          ]
        }
      ],
      "operation_category": "validate",
      "required_capabilities": [
        "dotnet-format-check"
      ],
      "required_prerequisites": [
        "dotnet-sdk"
      ],
      "require_repository_entrypoint": true
    },
    {
      "id": "shell",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "**/*.sh"
          ]
        }
      ],
      "operation_category": "validate",
      "required_capabilities": [
        "shellcheck"
      ],
      "required_prerequisites": [
        "shellcheck"
      ],
      "require_repository_entrypoint": true
    }
  ],
  "checks": [
    {
      "id": "shellcheck",
      "when": [{"kind": "path-any", "value": ["**/*.sh"]}],
      "command": ["shellcheck", "--severity=error", "--"],
      "cwd": "."
    },
    {
      "id": "npm-markdown-lint",
      "when": [
        {
          "kind": "package-script",
          "manager": "npm",
          "value": "lint:markdown"
        }
      ],
      "command": [
        "{npm}",
        "run",
        "lint:markdown"
      ],
      "cwd": "."
    },
    {
      "id": "npm-lint",
      "when": [
        {
          "kind": "package-script",
          "manager": "npm",
          "value": "lint"
        }
      ],
      "command": [
        "{npm}",
        "run",
        "lint"
      ],
      "cwd": "."
    },
    {
      "id": "npm-build",
      "when": [
        {
          "kind": "package-script",
          "manager": "npm",
          "value": "build"
        }
      ],
      "command": [
        "{npm}",
        "run",
        "build"
      ],
      "cwd": "."
    },
    {
      "id": "pnpm-markdown-lint",
      "when": [
        {
          "kind": "package-script",
          "manager": "pnpm",
          "value": "lint:markdown"
        }
      ],
      "command": [
        "{pnpm}",
        "run",
        "lint:markdown"
      ],
      "cwd": "."
    },
    {
      "id": "pnpm-lint",
      "when": [
        {
          "kind": "package-script",
          "manager": "pnpm",
          "value": "lint"
        }
      ],
      "command": [
        "{pnpm}",
        "run",
        "lint"
      ],
      "cwd": "."
    },
    {
      "id": "pnpm-build",
      "when": [
        {
          "kind": "package-script",
          "manager": "pnpm",
          "value": "build"
        }
      ],
      "command": [
        "{pnpm}",
        "run",
        "build"
      ],
      "cwd": "."
    },
    {
      "id": "pnpm-typecheck",
      "when": [
        {
          "kind": "package-script",
          "manager": "pnpm",
          "value": "typecheck"
        }
      ],
      "command": [
        "{pnpm}",
        "run",
        "typecheck"
      ],
      "cwd": "."
    },
    {
      "id": "npm-typecheck",
      "when": [
        {
          "kind": "package-script",
          "manager": "npm",
          "value": "typecheck"
        }
      ],
      "command": [
        "{npm}",
        "run",
        "typecheck"
      ],
      "cwd": "."
    },
    {
      "id": "ruff",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "ruff.toml",
            ".ruff.toml"
          ]
        },
        {
          "kind": "file-contains",
          "path": "pyproject.toml",
          "value": "[tool.ruff"
        },
        {
          "kind": "file-contains",
          "path": "requirements-dev.txt",
          "value": "ruff"
        },
        {
          "kind": "file-contains",
          "path": "requirements.txt",
          "value": "ruff"
        },
        {
          "kind": "file-contains",
          "path": "scripts/pyproject.toml",
          "value": "[tool.ruff"
        }
      ],
      "command": [
        "{python}",
        "-m",
        "ruff",
        "check",
        "."
      ],
      "cwd": "."
    },
    {
      "id": "mypy",
      "when": [
        {
          "kind": "path-any",
          "value": [
            "mypy.ini",
            ".mypy.ini"
          ]
        },
        {
          "kind": "file-contains",
          "path": "pyproject.toml",
          "value": "[tool.mypy]"
        },
        {
          "kind": "file-contains",
          "path": "requirements-dev.txt",
          "value": "mypy"
        },
        {
          "kind": "file-contains",
          "path": "requirements.txt",
          "value": "mypy"
        },
        {
          "kind": "file-contains",
          "path": "scripts/pyproject.toml",
          "value": "[tool.mypy"
        }
      ],
      "command": [
        "{python}",
        "-m",
        "mypy"
      ],
      "cwd": "."
    },
    {
      "id": "yaml-lint",
      "when": [
        {
          "kind": "path-any",
          "value": [
            ".yamllint",
            ".yamllint.yml",
            ".yamllint.yaml",
            "scripts/.yamllint",
            "scripts/.yamllint.yaml",
            "scripts/.yamllint.yml"
          ]
        }
      ],
      "command": [
        "{python}",
        "-m",
        "yamllint",
        "."
      ],
      "cwd": "."
    },
    {
      "id": "actionlint",
      "when": [
        {
          "kind": "path-any",
          "value": [
            ".github/workflows/**/*.yml",
            ".github/workflows/**/*.yaml"
          ]
        }
      ],
      "command": [
        "{python}",
        "scripts/run-actionlint.py"
      ],
      "cwd": "."
    }
  ]
}
