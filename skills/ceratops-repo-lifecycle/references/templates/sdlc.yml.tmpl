version: 5
kind: ceratops-sdlc
# Lifecycle order: pre-build-checks, build, post-build-checks, then requested delivery.
# Ceratops records native source checks and reuses applicable passes.
# Test runners can supply case-level evidence through their result contract.
# Keep source scans and tests in separate check-groups; each group owns its command.
# Package-based Install actions use install-inputs: accepted-build, declare
# target/destination parameters, and return ceratops-deployment-result.v1 with
# version/destination. Commands receive {artifact_receipt}, {package_file},
# {installer_dependencies} (JSON array), or {install_input_file} (all values).
repository:
  tools:
    # Point version-from.file at this target's native version metadata; use key
    # for a manifest field, or omit key for a single-value file such as .nvmrc.
    # Inline version/channel are invalid. Omit version-from for unversioned tools.
    uv:
      executable: uv
  actions:
    bootstrap:
      requires:
        tools: [uv]
      steps:
        - run: [uv, sync, --project, scripts, --locked]
        # Compatibility adds the portable Node bootstrap from the repository
        # validation contract when the repository owns a package lockfile.
    pre-build-checks:
      check-groups:
        # Compatibility adds one source group for each applicable catalog check:
        # Ruff, mypy, Actionlint, shellcheck, YAML lint, or package scripts.
        # Each runs directly and records its own result and input paths.
        tests:
          requires:
            tools: []
          no-op: No repository test command has been detected or declared.
