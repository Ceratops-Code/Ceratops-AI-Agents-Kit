version: 5
kind: ceratops-sdlc
# Lifecycle order: pre-build-checks, build, post-build-checks, then requested delivery.
# Ceratops records native source checks and reuses applicable passes.
# Test runners can supply case-level evidence through their result contract.
# Keep source scans and tests in separate check-groups; each group owns its command.
repository:
  tools:
    # Point version-from.file at this target's native version metadata; use key
    # for a manifest field, or omit key for a single-value file such as .nvmrc.
    # Inline version/channel are invalid. Omit version-from for unversioned tools.
    uv:
      executable: uv
  actions:
    bootstrap:
      requires:
        tools: [uv]
      steps:
        - run: [uv, sync, --project, scripts, --locked]
    pre-build-checks:
      check-groups:
        tests:
          requires:
            tools: []
          no-op: No repository test command has been detected or declared.
