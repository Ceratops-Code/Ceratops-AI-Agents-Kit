[project]
name = "repository-tools"
version = "0.0.0"
requires-python = ">=3.11"
dependencies = __DEPENDENCIES__

[tool.uv]
package = false

[tool.uv.workspace]
members = []

[tool.ruff]
target-version = "py314"

[tool.ruff.lint]
select = [
  "E", "F", "I", "B",
  # Credentials, disabled HTTPS checks, and shell execution.
  "S105", "S106", "S107", "S501", "S602", "S604", "S605",
  # Blocking network, process, filesystem, input, and sleep calls in async code.
  "ASYNC210", "ASYNC212", "ASYNC220", "ASYNC221", "ASYNC222",
  "ASYNC230", "ASYNC240", "ASYNC250", "ASYNC251",
  "DTZ003", "DTZ004", "DTZ005", "DTZ006", "UP", "RUF100",
]
ignore = ["E501"]

[tool.mypy]
files = ["."]
exclude = ["(^|/)\\.venv/"]
ignore_missing_imports = true
check_untyped_defs = true
warn_unused_configs = true
