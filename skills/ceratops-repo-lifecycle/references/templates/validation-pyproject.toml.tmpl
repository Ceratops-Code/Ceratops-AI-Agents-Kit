[project]
name = "repository-tools"
version = "0.0.0"
requires-python = ">=3.11"
dependencies = __DEPENDENCIES__

[tool.uv]
package = false

[tool.uv.workspace]
members = []

[tool.ruff]
# The contract renderer supplies the shared Python target and rule policy.

[tool.ruff.lint]

[tool.mypy]
files = ["."]
exclude = ["(^|/)\\.venv/"]
ignore_missing_imports = true
check_untyped_defs = true
warn_unused_configs = true
