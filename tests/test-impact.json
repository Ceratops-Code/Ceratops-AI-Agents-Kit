  "rules": [
    {
      "id": "ceratops-design-document-lifecycle-source",
      "paths": [
        "skills/ceratops-design-document-lifecycle/**"
      ],
      "suites": [
        "ceratops-design-document-lifecycle"
      ]
    },
    {
      "id": "mcp_server_manager_source",
      "paths": [
        ".codex/config.toml",
        "mcp-servers/**",
        "scripts/deploy-mcp-server-manager.py"
      ],
      "suites": [
        "mcp_server_manager"
      ]
    },
    {
      "id": "mcp-server-lifecycle-source",
      "paths": [
        "skills/ceratops-mcp-server-lifecycle/**"
      ],
      "suites": [
        "mcp_server_manager",
        "repository-lifecycle"
      ]
    },
    {
      "id": "credit-analysis-source",
      "paths": [
        "skills/ceratops-credit-savings-analysis/**",
        "skills/ceratops-misunderstanding-audit/**"
      ],
      "suites": [
        "credit-analysis"
      ]
    },
    {
      "id": "governance-lifecycle-source",
      "paths": [
        "skills/ceratops-governance-lifecycle/**"
      ],
      "suites": [
        "governance-lifecycle"
      ]
    },
    {
      "id": "repository-lifecycle-source",
      "paths": [
        "docs/result_records.py.tmpl",
        "skills/ceratops-repo-lifecycle/**",
        "sdlc/**"
      ],
      "suites": [
        "repository-lifecycle"
      ]
    },
    {
      "id": "skill-lifecycle-source",
      "paths": [
        "scripts/deploy-skills.py",
        "skills/ceratops-skill-lifecycle/**"
      ],
      "suites": [
        "repository-lifecycle",
        "skill-lifecycle"
      ]
    },
    {
      "id": "task-lifecycle-source",
      "paths": [
        "skills/ceratops-task-lifecycle/**"
      ],
      "suites": [
        "task-lifecycle"
      ]
    },
    {
      "id": "test-hook-source",
      "paths": [
        "scripts/deploy-hooks.py",
        "hooks/*.py",
        "tools/source_search_mcp.py",
        "tools/pyproject.toml",
        "tools/mcp-server.json",
        "tools/uv.lock"
      ],
      "suites": [
        "test-infrastructure"
      ]
    }
  ],
  "full_suite_paths": [
    ".github/dependabot.yml",
    ".github/workflows/**",
    ".gitignore",
    "AGENTS.history.json",
    "AGENTS.md",
    "scripts/.markdownlint.json",
    "scripts/.yamllint.yml",
    "scripts/package-lock.json",
    "scripts/package.json",
    "scripts/result_records.py",
    "scripts/testing/run-tests.py",
    "scripts/testing/runner_requests.py",
    "scripts/testing/select_test_groups.py",
    "scripts/testing/pytest-diagnostics.py",
    "scripts/testing/pytest-environment.py",
    "scripts/testing/report_test_progress.py",
    "scripts/testing/reuse_test_results.py",
    "scripts/run-actionlint.py",
    "scripts/validate-repository.py",
    "skills/ceratops-automation-run/**",
    "skills/ceratops-code-consistency-audit/**",
    "skills/codex-desktop-upgrade/**",
    "skills/sections/**",
    "skills/skill-sections.json",
    "tests/__init__.py",
    "tests/conftest.py",
    "tests/support/**",
    "tests/test-impact.json",
    "scripts/pyproject.toml",
    "scripts/uv.lock"
  ],
  "ignored_paths": [
    {
      "id": "documentation-only",
      "paths": [
        ".github/CODEOWNERS",
        ".github/ISSUE_TEMPLATE/**",
        ".github/pull_request_template.md",
        "Ceratops-Logo/*.png",
        "Ceratops-Logo/resized/*.png",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "docs/design-draft.md",
        "LICENSE",
        "README.md",
        "hooks/README.md"
      ],
      "reason": "These files contain repository documentation, branding assets, or contribution metadata and cannot change executable behavior."
    }
  ],
  "unmapped_production": "error"
}
